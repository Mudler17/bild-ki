# Vorlage für die lokale Entwicklung: kopieren nach .env und ausfüllen.
# In Coolify dieselben Namen unter „Environment Variables“ eintragen (nicht als Build-Variable!).

# ---------- Pflicht ----------
# Passwort für den Zugang zur App (mind. 12 Zeichen). Ohne Passwort startet der Server nicht.
APP_ACCESS_PASSWORD=
# Zufälliger Schlüssel für die Anmelde-Cookies, z. B. erzeugt mit: openssl rand -hex 32
SESSION_SECRET=
# OpenAI-API-Schlüssel – bleibt ausschließlich auf dem Server
OPENAI_API_KEY=

# ---------- Empfohlen hinter Cloudflare + Traefik (Coolify) ----------
TRUST_PROXY=2
# Erlaubte Herkunft(en) für Anfragen, kommagetrennt
APP_ALLOWED_ORIGINS=https://bild-ki.ki-kernel.de

# ---------- Optional ----------
# Modell für Bildanalyse und Wiki (Standard: gpt-5.6-terra)
OPENAI_MODEL=gpt-5.6-terra
# Eigenes (z. B. günstigeres) Modell nur für Wiki-Artikel
OPENAI_WIKI_MODEL=
# Ausweichmodell, falls OPENAI_MODEL nicht (mehr) verfügbar ist
OPENAI_FALLBACK_MODEL=
# Denkaufwand: none | minimal | low | medium | high | xhigh | max (leer = Modell-Standard)
OPENAI_REASONING_EFFORT=
# Bilddetail: low | high | auto | original
OPENAI_IMAGE_DETAIL=high
OPENAI_MAX_OUTPUT_TOKENS=25000
AI_TIMEOUT_MS=180000
# KI-Anfragen je IP in 15 Minuten
AI_RATE_LIMIT=30
# KI-Anfragen pro Tag insgesamt (Kostenbremse), 0 = unbegrenzt
AI_DAILY_LIMIT=200
MAX_IMAGE_MB=8
SESSION_DAYS=30
PORT=3000

# Demo-Modus ohne echte KI (zum Ausprobieren ohne API-Key)
AI_MOCK=
